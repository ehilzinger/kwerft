# Appended to apple/containerization kernel/config-arm64 (0.48.0) to run the
# same stack as a Kwerft server (k3s or kind, Cilium, WireGuard).

# kind's node entrypoint and `container k8s` node prep use iptables-legacy;
# Linux 6.18 only builds the legacy tables with these switched on.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y

# Cilium's requirements (docs.cilium.io, system requirements) that Apple's
# config leaves out: the agent refuses to start without the eBPF JIT.
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_SCHEDSTATS=y
# Socket termination for kube-proxy replacement (closes sockets to deleted backends).
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_DIAG_DESTROY=y

# A stable node address for k3s in a container machine: the VM's eth0 address
# changes on every start, and etcd and the node IP must not.
CONFIG_DUMMY=y

# BTF: Cilium 1.20 loads its programs with CO-RE relocations and fails with
# "no BTF found for kernel version" without it. Needs pahole in the build image.
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
