# Ubuntu 24.04 with systemd as PID 1, close to a fresh Hetzner server, so the
# real install.sh can run unchanged inside a container machine.
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      systemd systemd-sysv dbus iproute2 iputils-ping curl ca-certificates \
      sudo kmod nftables iptables jq less \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
