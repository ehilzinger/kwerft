{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kwerft",
      "runtimeExecutable": "go",
      "runtimeArgs": ["run", "./cmd/kwerft", "--listen=:8080", "--console-domain=localhost", "--platform=cloud", "--controllers=false"],
      "port": 8080
